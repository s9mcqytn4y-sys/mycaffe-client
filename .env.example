# ------------------------------------------------------------------------------
# Web PWA Configuration (apps/web)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
NEXT_PUBLIC_MEDIA_CDN_URL=https://cdn.abbdullaziz.online
NEXT_PUBLIC_APP_ENV=development

# ------------------------------------------------------------------------------
# Android POS Configuration (apps/android)
# ------------------------------------------------------------------------------
# Default backend URL used for local tablet emulator testing (10.0.2.2 = host machine)
CASSY_ANDROID_API_HOST=http://10.0.2.2:8080
CASSY_ANDROID_WS_HOST=ws://10.0.2.2:8080/ws
CASSY_DEFAULT_PRINTER_IP=192.168.1.200
CASSY_DEFAULT_PRINTER_PORT=9100

