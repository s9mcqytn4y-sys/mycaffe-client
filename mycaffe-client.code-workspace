{
  "folders": [
    {
      "name": "Web PWA (Next.js 15)",
      "path": "apps/web"
    },
    {
      "name": "Android POS (Compose)",
      "path": "apps/android"
    },
    {
      "name": "iOS printer bridge (Objective-C)",
      "path": "apps/ios"
    },
    {
      "name": "Design tokens",
      "path": "packages/design-tokens"
    },
    {
      "name": "Repo root",
      "path": "."
    }
  ],
  "settings": {
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "files.eol": "\n",
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "search.exclude": {
      "**/node_modules": true,
      "**/.next": true,
      "**/.gradle": true,
      "**/build": true,
      "**/.build": true,
      "**/out": true
    }
  },
  "extensions": {
    "recommendations": [
      "dbaeumer.vscode-eslint",
      "bradlc.vscode-tailwindcss",
      "fwcd.kotlin",
      "vscjava.vscode-gradle"
    ]
  }
}
