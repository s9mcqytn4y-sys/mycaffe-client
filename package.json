{
  "name": "@azuredevid/mycaffe-client",
  "version": "1.0.0",
  "private": true,
  "description": "Unified Client Monorepo for MyCaffe by AzureDevID (online.abbdullaziz.mycaffe: Web PWA QR Order/Backoffice/Superadmin, Android Jetpack Compose POS, iOS Bridge & Shared Design Tokens)",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "npm --workspace @azuredevid/mycaffe-web run dev",
    "build": "npm --workspace @azuredevid/mycaffe-web run build",
    "typecheck": "npm --workspace @azuredevid/mycaffe-web run typecheck",
    "tokens:verify": "node packages/design-tokens/verify-tokens.mjs",
    "android:check": "apps\\android\\gradlew.bat -p apps/android help",
    "android:assemble": "apps\\android\\gradlew.bat -p apps/android assembleDebug",
    "ios:lint-objc": "powershell -ExecutionPolicy Bypass -File apps/ios/scripts/Verify-ObjCSyntax.ps1"
  }
}
