{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Android: Test + bundleDevDebug (PR gate)",
      "type": "shell",
      "command": ".\\gradlew.bat testDevDebugUnitTest bundleDevDebug --no-daemon --console=plain",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Android: Unit tests (devDebug)",
      "type": "shell",
      "command": ".\\gradlew.bat testDevDebugUnitTest --no-daemon --console=plain",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Android: All flavors unit tests + bundleDebug (CI parity)",
      "type": "shell",
      "command": ".\\gradlew.bat test bundleDebug --max-workers=2 --no-daemon --console=plain",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Android: Assemble devDebug APK",
      "type": "shell",
      "command": ".\\gradlew.bat assembleDevDebug --no-daemon --console=plain",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Android: Install and launch devDebug on device (ADB)",
      "type": "shell",
      "command": "adb install -r app/build/outputs/apk/dev/debug/app-dev-debug.apk; if ($LASTEXITCODE -eq 0) { adb shell am start -W -n com.azuredevid.cassy.dev/com.azuredevid.cassy.MainActivity }",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "Android: Start headless tablet emulator",
      "type": "shell",
      "command": "emulator -avd Medium_Tablet -no-window -no-audio -no-boot-anim",
      "isBackground": true,
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "Android: Capture emulator screen",
      "type": "shell",
      "command": "adb exec-out screencap -p > emulator_screen.png",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "Android: Dump UI hierarchy (Android CLI)",
      "type": "shell",
      "command": "android layout --pretty",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "none",
      "problemMatcher": []
    }
  ]
}
