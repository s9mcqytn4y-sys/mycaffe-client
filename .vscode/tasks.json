{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Web: Dev Server (:3000)",
      "type": "shell",
      "command": "npm --workspace @azuredevid/mycaffe-web run dev",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Web: Typecheck & Production Build",
      "type": "shell",
      "command": "npm --workspace @azuredevid/mycaffe-web run typecheck && npm --workspace @azuredevid/mycaffe-web run build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Design Tokens: Verify WCAG AA & i18n",
      "type": "shell",
      "command": "node packages/design-tokens/verify-tokens.mjs",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Android: Assemble Debug APK",
      "type": "shell",
      "command": ".\\apps\\android\\gradlew.bat -p apps/android assembleDebug",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "iOS: Verify Objective-C Hardware Bridge",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File apps/ios/scripts/Verify-ObjCSyntax.ps1",
      "group": "test",
      "problemMatcher": []
    }
  ]
}

