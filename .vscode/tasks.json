{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Web: Dev Server (:3000)",
      "type": "shell",
      "command": "pnpm --filter @azuredevid/mycaffe-web run dev",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Web: Typecheck & Production Build",
      "type": "shell",
      "command": "pnpm --filter @azuredevid/mycaffe-web run typecheck && pnpm --filter @azuredevid/mycaffe-web run build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Web: Playwright E2E Tests",
      "type": "shell",
      "command": "pnpm --filter @azuredevid/mycaffe-web test:e2e",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Design Tokens: Verify WCAG AA & i18n",
      "type": "shell",
      "command": "node packages/design-tokens/verify-tokens.mjs",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Android: Assemble Debug APK",
      "type": "shell",
      "command": ".\\apps\\android\\gradlew.bat -p apps/android assembleDebug",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Android: Build App Bundle (AAB)",
      "type": "shell",
      "command": ".\\apps\\android\\gradlew.bat -p apps/android bundleDebug",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Android: Run Unit Tests",
      "type": "shell",
      "command": ".\\apps\\android\\gradlew.bat -p apps/android test",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Android: Launch Cassy Tablet Emulator (Medium_Tablet)",
      "type": "shell",
      "command": "& \"$env:LOCALAPPDATA\\Android\\Sdk\\emulator\\emulator.exe\" -avd Medium_Tablet -gpu host -accel on -memory 4096",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Android: Install Debug APK via ADB",
      "type": "shell",
      "command": "adb install -r apps/android/app/build/outputs/apk/debug/app-debug.apk",
      "dependsOn": "Android: Assemble Debug APK",
      "problemMatcher": []
    },
    {
      "label": "iOS: Verify Objective-C Hardware Bridge",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File apps/ios/scripts/Verify-ObjCSyntax.ps1",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
